# ---------------------------------------------------------------------------
# SABI server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Gemini API key. Server-side only: it must never be exposed through a VITE_ var.
GEMINI_API_KEY=

# Supabase (Dashboard -> Project Settings -> API)
# The service-role key is REQUIRED by the API outside of tests; the server refuses
# to boot in production without it. It bypasses RLS, so keep it server-side only.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for VITE_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY used by the server.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Public URL of the web app. Used as the password-recovery redirect target.
SABI_APP_URL=https://your-app.example.com

# Comma separated extra CORS origins (production web app, preview URLs, ...).
# localhost, the Capacitor WebView (capacitor://localhost, https://localhost) and
# sabi*.vercel.app are always allowed.
ALLOWED_ORIGINS=

# Set to "false" to stop the server from confirming new accounts immediately after
# sign-up (use once the email OTP / verification flow is enabled in Phase 1).
SABI_INSTANT_VERIFY=true

# Rate limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# AUTH_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_MAX=20

# Maximum JSON request body size (default 256kb)
# MAX_JSON_BODY=256kb

# Backend API URL for Capacitor Android APK (Points the mobile app to your live backend server)
VITE_API_BASE_URL=https://ais-pre-hexoysblc7dzfjy3yyprez-26118416277.europe-west1.run.app
